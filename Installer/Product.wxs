<?xml version="1.0" encoding="UTF-8"?>
<!--
  Laid out like the official releases' installer: a per-user install to %LocalAppData%\FPVTrackside with Start
  menu and desktop shortcuts, no setup dialogs, replacing whichever version is installed, older or newer. Its
  upgrade code and component paths match theirs, so a release can be installed over this and this over a release.

  Built by build-msi.ps1, which harvests the published files into the AppFiles component group, and names the
  product with the build's label (e.g. FPVTrackside BIRD) so it isn't mistaken for a release in installed apps.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="$(var.ProductName)" Language="1033" Version="$(var.Version)" Manufacturer="uewepuep" UpgradeCode="F6739AC9-17BE-4D41-B467-3291187040DC">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perUser" />

    <Upgrade Id="F6739AC9-17BE-4D41-B467-3291187040DC">
      <UpgradeVersion Minimum="1.0.0.0" IncludeMinimum="yes" Maximum="99.0.0.0" IncludeMaximum="no" Property="PREVIOUSVERSIONSINSTALLED" />
    </Upgrade>

    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>

    <Property Id="REINSTALLMODE" Value="dmus" />

    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="FPVTrackside" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="FPVTrackside" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationStartMenuShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="FPVTrackside" Description="FPVTrackside" Target="[INSTALLFOLDER]$(var.ExeName)" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Microsoft\FPVTrackside" Name="startmenuinstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="ApplicationDesktopShortcut" Guid="*">
        <Shortcut Id="ApplicationDesktopShortcut" Name="FPVTrackside" Description="FPVTrackside" Target="[INSTALLFOLDER]$(var.ExeName)" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Microsoft\FPVTrackside" Name="desktopinstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="FPVTrackside" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationStartMenuShortcut" />
      <ComponentRef Id="ApplicationDesktopShortcut" />
    </Feature>
  </Product>
</Wix>
